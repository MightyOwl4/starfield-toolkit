# EditorConfig — https://editorconfig.org
# Project convention: 4-space indent everywhere, regardless of ecosystem defaults.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows-native batch files must keep CRLF.
[*.{bat,cmd}]
end_of_line = crlf

# Markdown: keep trailing whitespace (it's a hard line break).
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs.
[Makefile]
indent_style = tab
